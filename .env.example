# Server port (Render sets this automatically)
PORT=5000

# MongoDB connection string (Atlas free cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pwnfolio

# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# Frontend origin allowed by CORS (Vercel URL in prod, http://localhost:5173 in dev)
CLIENT_URL=http://localhost:5173